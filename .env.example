# Backend Environment Variables
# Copy this file to .env and fill in your values

PORT=3000
JWT_SECRET=your_super_secret_key_minimum_32_chars_change_this

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devicedb
DB_USER=deviceadmin
DB_PASSWORD=yourpassword
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=2000

# File upload path
UPLOAD_PATH=./uploads

# CORS — set to your dashboard URL in production
CORS_ORIGIN=*
